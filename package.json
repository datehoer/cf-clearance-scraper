{
  "name": "cf-clearance-scraper",
  "version": "2.1.3",
  "main": "index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --experimental-vm-modules ./node_modules/.bin/jest --detectOpenHandles --verbose --testPathIgnorePatterns=tests/endpoints.test.js",
    "test:e2e": "RUN_E2E=true node --experimental-vm-modules ./node_modules/.bin/jest --detectOpenHandles --verbose tests/endpoints.test.js --runInBand"
  },
  "jest": {
    "testMatch": [
      "**/tests/**/*.js"
    ],
    "verbose": true
  },
  "keywords": [
    "cf-clearance",
    "cloudflare",
    "waf",
    "scraper",
    "patchright",
    "playwright",
    "xvfb",
    "turnstile",
    "bypass",
    "undetected",
    "stealth"
  ],
  "author": "zfcsoftware",
  "license": "ISC",
  "description": "This package is an experimental and educational package created for Cloudflare protections.",
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "body-parser": "^2.3.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "patchright": "^1.63.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  }
}
